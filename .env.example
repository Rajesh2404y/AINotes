# ===================================================
# AI Notes Summarizer - Environment Configuration
# ===================================================

# Application Environment (development, testing, production)
FLASK_ENV=development
FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=dev-insecure-secret-key-change-in-production-32chars
PORT=5000

# Database Configuration
# Local SQLite default: sqlite:///ainotes.db
# MySQL production example: mysql+pymysql://username:password@localhost:3306/ainotes_db
DATABASE_URL=sqlite:///ainotes.db

# JWT Authentication
JWT_SECRET_KEY=dev-jwt-super-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE_MB=20
MAX_CONTENT_LENGTH_MB=20
ALLOWED_EXTENSIONS=pdf,docx,txt,png,jpg,jpeg

# AI Engine Configuration
AI_DEVICE=cpu
MODEL_DEVICE=auto
MODEL_CACHE_DIR=model_cache
SUMMARIZATION_MODEL=sshleifer/distilbart-cnn-12-6
STRUCTURED_EXTRACTION_MODEL=google/flan-t5-base
QUIZ_MODEL=google/flan-t5-base
TRANSLATION_ENABLED=true
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_DEVICE=auto
TRANSLATION_CACHE_DIR=backend/model_cache
TRANSLATION_MAX_INPUT_TOKENS=900
TRANSLATION_CHUNK_OVERLAP=80
TRANSLATION_BATCH_SIZE=4
TRANSLATION_MAX_RETRIES=2
SUMMARIZATION_ENABLED=true
MAX_SUMMARY_INPUT_TOKENS=900
SUMMARY_CHUNK_OVERLAP=100

# OCR Configuration
OCR_ENABLED=true
TESSERACT_CMD=
TESSERACT_LANGUAGES=eng+tam

# Phase 9: Personalized Learning Recommendations
WEAK_TOPIC_THRESHOLD=50
MODERATE_TOPIC_THRESHOLD=70
STRONG_TOPIC_THRESHOLD=85
MIN_ATTEMPTS_FOR_CLASSIFICATION=3
